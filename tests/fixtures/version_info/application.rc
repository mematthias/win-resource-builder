// Reference for tests/golden/version_info.rs: executable, language neutral, common strings
LANGUAGE 0, 0

1 VERSIONINFO
FILEVERSION 1, 2, 3, 4
PRODUCTVERSION 5, 6, 7, 8
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName", "Example Company"
            VALUE "FileDescription", "Example Application"
            VALUE "FileVersion", "1.2.3.4"
            VALUE "InternalName", "example"
            VALUE "LegalCopyright", "Copyright (C) 2026 Example Company"
            VALUE "OriginalFilename", "example.exe"
            VALUE "ProductName", "Example Product"
            VALUE "ProductVersion", "5.6.7.8"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
